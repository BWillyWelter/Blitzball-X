{
  "name": "blitzball-x",
  "version": "1.1.0",
  "description": "BLITZBALL X \u2014 arcade underwater 3-on-3 Blitzball. Turbo, tricks, washes, big hits, keepers, Gamebreakers. Two halves, most goals wins.",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs test/*.test.js",
    "sim": "node scripts/simulate.mjs",
    "golden:update": "node scripts/snapshot.mjs --update",
    "server": "node server/index.js",
    "qa:screens": "node tools/screens.mjs",
    "qa:play": "node tools/playtest.mjs",
    "qa:shot": "node tools/shot.mjs",
    "qa:probe": "node tools/probe.mjs",
    "qa:touch": "node tools/touchtest.mjs",
    "qa:context": "node tools/contexttest.mjs",
    "qa:bench": "node tools/benchtest.mjs",
    "qa:perf": "node tools/perfshot.mjs",
    "qa:merge": "node tools/mergecheck.mjs",
    "qa:lighthouse": "node tools/lighthouse.mjs",
    "qa:anim": "node tools/anim.mjs",
    "cap:build": "npm run build && npx cap copy",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:run:ios": "npm run cap:sync && npx cap run ios",
    "cap:run:android": "npm run cap:sync && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@sparticuz/chromium": "^149.0.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.10.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
